# pathlib — file I/O, with effects inferred and failure made total.
#
#   pyfun run examples/interop/read_files.pyfun
#
# The compiler infers these calls are `io` and propagates it outward with no
# annotation, and `try` turns a missing-file error into a `Result`. Runs offline
# and cleans up after itself.

extern type Path
extern to_path: str -> Path = pathlib.Path
extern write_text: Path -> str -> int = pathlib.Path.write_text
extern read_text: Path -> str = pathlib.Path.read_text
extern unlink: Path -> unit = pathlib.Path.unlink

# `round_trip` calls `io` externs, so it is inferred `io` too — a `let pure round_trip`
# would be a compile error. Purity is checked, not hoped for.
let round_trip name =
  let p = to_path name
  let _ = write_text p "hello from pyfun"
  let back = read_text p
  let _ = unlink p
  back

# Reading a missing file is total: `try` catches FileNotFoundError into `Error`.
let read_or_note name =
  match try (read_text (to_path name)):
    case Ok s: s
    case Error e: f"(could not read {name}: {e.error_kind})"

print (round_trip "pyfun_interop_demo.txt")   # hello from pyfun
print (read_or_note "no_such_file.txt")        # (could not read no_such_file.txt: FileNotFoundError)
