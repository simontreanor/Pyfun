# Direct trains from a station, grouped by destination — a Network Rail SCHEDULE
# feed turned into a readable Markdown timetable, with NO Python helper: the file
# is streamed, parsed, and rendered entirely in Pyfun.
#
#   cargo run -- run examples/interop/network-rail/chippenham.pyfun
#
# This is the boundary-vs-engine interop pattern taken to its limit — even the
# streaming boundary is Pyfun. The file object from `open`/`gzip.open` is consumed
# as a lazy `Seq str`, so a ~3 GB NDJSON snapshot streams in constant memory; a
# substring prefilter skips JSON parsing on the lines that can't match; and the
# `Decode` module turns each surviving line into typed data — no dict-poking, no
# bespoke Python. `open`/`gzip.open`'s mode + encoding and `write_text`'s encoding
# + newline are pinned as `extern` keyword arguments (see the externs below), so the Python
# call carries `encoding="utf-8"` without any positional filler.
#
# Runs out of the box against the bundled `sample.ndjson`. For the real feed
# (register at https://opendata.nationalrail.co.uk / Network Rail data feeds),
# point `data_file` at your snapshot — the EXACT filename, `.json` or `.json.gz`
# (a `.gz` is detected by extension and streamed without decompressing).
#
# Performance: driving the ~20M-line loop through `Seq.fold` is correctness- and
# clarity-first, not throughput-first — expect a minute or two on the full feed
# (a native Python loop is faster, but that puts the hot path back in Python).
#
# STP caveat: counts reflect the day-of-week pattern of permanent + new schedules
# minus full cancellations (stp "C"), deduped by (departure, destination). A
# specific calendar date may differ. A full snapshot is all `Create` records, so
# transaction type isn't checked.

# `mode="rt"` opens the file as text and `encoding="utf-8"` reads UTF-8 instead of
# the platform locale (cp1252 on Windows) — both correct for the feed and ~5s
# faster on the full file. Pinning them as `extern` keyword arguments reaches
# `encoding` (a keyword-only / deep-positional arg) with no positional filler.
extern open_text: str -> Seq str = builtins.open(mode = "rt", encoding = "utf-8")
extern gzip_text: str -> Seq str = gzip.open(mode = "rt", encoding = "utf-8")
extern type Path
extern to_path: str -> Path = pathlib.Path
extern write_text: Path -> str -> int = pathlib.Path.write_text(encoding = "utf-8", newline = "\n")

type Stop = { tiploc: str, arr: str, dep: str }
type Run = { uid: str, days: str, stp: str, stops: List Stop }
type Leg = { dest: str, final_dest: str, rdays: str, dep_min: int, arr_min: int, jt: int, via: List str }

let data_file = "examples/interop/network-rail/sample.ndjson"
let out_file = "examples/interop/network-rail/chippenham-routes.md"

# --- streaming boundary, in Pyfun: the file object is a lazy Seq of lines ---
let lines path =
  if String.ends_with ".gz" path then gzip_text path else open_text path

# --- decode the relevant lines into typed data (parse, don't validate) ---
let opt_str key = Decode.one_of [Decode.field key Decode.str, Decode.succeed ""]

let tip_dec =
  Decode.field "TiplocV1"
    (Decode.map2 (fun c n -> (c, n))
      (Decode.field "tiploc_code" Decode.str)
      (opt_str "tps_description"))

let stop_dec =
  Decode.map3 (fun t a d -> (t, a, d))
    (Decode.field "tiploc_code" Decode.str)
    (opt_str "public_arrival")
    (opt_str "public_departure")

let sched_dec =
  Decode.field "JsonScheduleV1"
    (Decode.map4 (fun uid days stp stops -> (uid, days, stp, stops))
      (Decode.field "CIF_train_uid" Decode.str)
      (opt_str "schedule_days_runs")
      (opt_str "CIF_stp_indicator")
      (Decode.field "schedule_segment" (Decode.field "schedule_location" (Decode.list stop_dec))))

# Fold the lazy line Seq into (tiploc names, Chippenham-calling runs). A cheap
# substring test skips JSON parsing on the millions of lines that can't match —
# the same prefilter the Python did, now in Pyfun and in constant memory.
let ingest acc line =
  match acc:
    case (names, runs):
      if String.contains "TiplocV1" line:
        match Decode.decode_string tip_dec line:
          case Ok (c, n): (Map.add c n names, runs)
          case Error _: acc
      else if String.contains "JsonScheduleV1" line and String.contains "CHIPNHM" line:
        match Decode.decode_string sched_dec line:
          case Ok r: (names, List.concat runs [r])
          case Error _: acc
      else acc

let scan path = Seq.fold ingest (Map.empty, []) (lines path)

# --- shape the decoded tuples into typed records ---
let to_stop t =
  match t:
    case (tp, a, d): Stop { tiploc = tp, arr = a, dep = d }

let to_run r =
  match r:
    case (uid, days, stp, stops):
      Run { uid = uid, days = days, stp = stp, stops = List.map to_stop stops }

# A stop is a public calling point iff it advertises a public time.
let calls s = (s.arr != "" and s.arr != "0000") or (s.dep != "" and s.dep != "0000")

let to_min hhmm =
  match (String.to_int (String.slice 0 2 hhmm), String.to_int (String.slice 2 4 hhmm)):
    case (Some h, Some m): h * 60 + m
    case _: -1

let fmt2 n = if n < 10 then f"0{n}" else f"{n}"
let show_time m = f"{fmt2 (m // 60)}:{fmt2 (m % 60)}"

let jtime dep arr =
  let d = arr - dep
  if d < 0 then d + 1440 else d

let from_chippenham stops =
  match stops:
    case []: None
    case [s, *rest]:
      if s.tiploc == "CHIPNHM" and calls s then Some (s.dep, rest)
      else from_chippenham rest

let last_tiploc stops =
  match stops:
    case []: ""
    case [s]: s.tiploc
    case [_, *rest]: last_tiploc rest

let walk_legs days term dep_m via stops =
  match stops:
    case []: []
    case [s, *rest]:
      if calls s:
        let arr_m = to_min s.arr
        let onward = List.concat via [s.tiploc]
        if arr_m < 0 then walk_legs days term dep_m onward rest
        else:
          let leg = Leg { dest = s.tiploc, final_dest = term, rdays = days, dep_min = dep_m,
            arr_min = arr_m, jt = jtime dep_m arr_m, via = via }
          List.concat [leg] (walk_legs days term dep_m onward rest)
      else walk_legs days term dep_m via rest

let legs_of_run r =
  if r.stp == "C" then []
  else:
    match from_chippenham r.stops:
      case None: []
      case Some (chipp_dep, downstream):
        let dep_m = to_min chipp_dep
        if dep_m < 0 then []
        else walk_legs r.days (last_tiploc downstream) dep_m [] downstream

let runs_on day days = String.slice day (day + 1) days == "1"

let dedup_legs legs =
  let step acc leg =
    match acc:
      case (seen, out):
        let k = f"{leg.dep_min}|{leg.dest}"
        match Map.find k seen:
          case Some _: (seen, out)
          case None: (Map.add k True seen, List.concat out [leg])
  match List.fold step (Map.empty, []) legs:
    case (_, out): out

let group_by_dest acc leg =
  Map.add leg.dest (List.concat (Option.with_default [] (Map.find leg.dest acc)) [leg]) acc

let insert_by_dep leg sorted =
  match sorted:
    case []: [leg]
    case [x, *rest]:
      if leg.dep_min <= x.dep_min then List.concat [leg] sorted
      else List.concat [x] (insert_by_dep leg rest)

let sort_legs legs = List.fold (fun acc l -> insert_by_dep l acc) [] legs

let min_of xs =
  match xs:
    case []: 0
    case [x]: x
    case [x, *rest]:
      let m = min_of rest
      if x < m then x else m

let max_of xs =
  match xs:
    case []: 0
    case [x]: x
    case [x, *rest]:
      let m = max_of rest
      if x > m then x else m

# --- title-casing (feed descriptions are UPPERCASE) ---
# Uppercase the first *alphabetic* char in a char list, leave the rest. The test
# `String.upper c != c` is true only for a lowercase letter, so "(south"
# capitalizes the s, not the "(".
let cap_first chars =
  match chars:
    case []: []
    case [c, *rest]:
      if String.upper c != c then List.concat [String.upper c] rest
      else List.concat [c] (cap_first rest)

let cap_word w = String.join "" (cap_first (String.to_list w))
let title_hyphen w = String.join "-" (List.map cap_word (String.split "-" w))
let title_case name = String.join " " (List.map title_hyphen (String.split " " (String.lower name)))

# --- rendering (Markdown) ---
let name_of names tp = title_case (Option.with_default tp (Map.find tp names))
let plural n word = if n == 1 then f"{n} {word}" else f"{n} {word}s"
let range_str lo hi = if lo == hi then f"{lo} min" else f"{lo}-{hi} min"

let render_service names leg =
  let stop_str =
    match leg.via:
      case []: "direct"
      case _:
        let via_str = String.join ", " (List.map (name_of names) leg.via)
        f"via {via_str}"
  let onward = if leg.dest == leg.final_dest then "" else f" _(to {name_of names leg.final_dest})_"
  f"- **{show_time leg.dep_min} → {show_time leg.arr_min}** · {leg.jt} min · {stop_str}{onward}"

let render_group names g =
  match g:
    case (dest, legs):
      let times = List.map (fun l -> l.jt) legs
      let tr = plural (List.len legs) "train"
      let header = f"### {name_of names dest} — {tr}, {range_str (min_of times) (max_of times)}"
      let body = String.join "\n" (List.map (render_service names) (sort_legs legs))
      f"{header}\n\n{body}"

let day_section names label day all_legs =
  let legs = dedup_legs (List.filter (fun l -> runs_on day l.rdays) all_legs)
  let pairs = List.map (fun g -> match g: case (dest, ls): (name_of names dest, render_group names g))
    (Map.to_list (List.fold group_by_dest Map.empty legs))
  let body = String.join "\n\n" (List.map (fun p -> match p: case (nm, txt): txt) (List.sort pairs))
  f"## {label}\n\n{body}"

let build_report names raw =
  let all_legs = List.fold (fun acc r -> List.concat acc (legs_of_run r)) [] (List.map to_run raw)
  let intro = "# Direct services from Chippenham\n\n_Every station reachable directly (no change) from Chippenham, grouped by destination, in departure order. Counts reflect the weekly day-of-week pattern of permanent + new schedules minus cancellations; a specific date may differ._"
  let wd = day_section names "Monday–Friday (representative day: Tuesday)" 1 all_legs
  let sa = day_section names "Saturday" 5 all_legs
  let su = day_section names "Sunday" 6 all_legs
  String.join "\n\n" [intro, wd, sa, su]

let _ =
  match scan data_file:
    case (names, raw): write_text (to_path out_file) (build_report names raw)

print (f"Wrote Markdown direct Chippenham services to {out_file}")
